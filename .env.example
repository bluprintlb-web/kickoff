# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/leader_sport?schema=public"

# Used to build the return URL the customer lands on after paying
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js — generate with: npx auth secret (or `openssl rand -base64 32`)
AUTH_SECRET=""
# Only needed when NOT deploying to Vercel and not on a standard https origin
# AUTH_TRUST_HOST=true

# PIN required in the admin UI to reveal/edit a product's cost price.
COST_PRICE_PIN=""

# Whish Pay (Whish wallet + Visa/Mastercard via their hosted checkout).
# Not usable until you have a real Whish merchant account — see
# src/lib/payments/whish.ts for details on what's still unverified.
WHISH_API_BASE_URL=""
WHISH_API_SECRET=""

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Firebase Auth (Google + phone/SMS login) — from the Firebase console's
# Project settings > General > Your apps > SDK setup and configuration.
# These are all client-safe values (Firebase's own design — access control
# happens via provider settings/Security Rules, not by hiding this config),
# but still env-configurable rather than hardcoded. See
# src/lib/firebase/client.ts and src/auth.ts's "firebase" provider.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# WhatsApp order notifications (see whatsapp-notifier/README.md) — DORMANT,
# not currently called from anywhere (dropped 2026-08-07 after fighting
# WhatsApp's anti-bot rate-limiting; replaced by the browser push
# notifications below). src/lib/notify-order.ts and the whatsapp-notifier/
# service still exist, deliberately left in place rather than deleted, in
# case this is ever revisited. Setting these currently does nothing.
NOTIFY_ORDER_URL=""
NOTIFY_ORDER_SECRET=""

# Browser push notifications for the admin panel (Web Push API) — replaces
# the WhatsApp notifier above. Generate a real key pair with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose client-side (that's the
# point of the public/private split); VAPID_PRIVATE_KEY is server-only and
# must be kept secret. VAPID_SUBJECT identifies the sender to push
# services per the Web Push spec — a mailto: or https: URL, e.g.
# "mailto:you@example.com". Checkout works fine without these set
# (src/lib/push-notify.ts silently no-ops) — this is optional.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
