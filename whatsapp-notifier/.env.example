# Port the Express server listens on. Railway sets this for you automatically
# in production — this default is only used for local dev.
PORT=3300

# Your own WhatsApp number to send order notifications to. Digits only,
# country code first, no "+", no spaces — e.g. Lebanon: 96181962691.
OWNER_WHATSAPP_NUMBER=

# A long random secret shared between this service and the main Kick Off
# app — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFY_SECRET=

# Where Baileys persists the WhatsApp session so it doesn't ask for a new
# QR code every restart. On Railway this MUST point inside your mounted
# volume (see README.md) or the session will be lost on every redeploy.
AUTH_DIR=./auth_info_baileys

# "silent" | "error" | "warn" | "info" | "debug" | "trace" — Baileys is
# very chatty at "info"/"debug", "warn" is a reasonable default.
BAILEYS_LOG_LEVEL=warn
